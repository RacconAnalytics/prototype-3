###############################################################################
#                              COMMON SETTINGS                                 #
###############################################################################

# Frontend
FRONTEND_BASE_URL=http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8081

###############################################################################
#                              API GATEWAY                                     #
###############################################################################

# Ports & Timeouts
PORT=8080
PROXY_TIMEOUT_SECONDS=30

# Service URLs
GOOGLE_TRENDS_SERVICE_URL=http://google-trends-service:8001
NLP_SERVICE_URL=http://nlp-service:8193
USER_SERVICE_URL=http://users-service:3001
YOUTUBE_SCRAPPER_SERVICE_URL=http://youtube-service:8000/api

###############################################################################
#                              USERS SERVICE                                   #
###############################################################################

# Database & Cache
DATABASE_URL=postgres://postgres:your_postgres_password@postgres:5432/users_db
REDIS_URL=redis://redis:6379

# GitHub OAuth
GITHUB_CALLBACK_URL=http://localhost:8081/api/users/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth
GOOGLE_CALLBACK_URL=http://localhost:8081/api/users/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:8081/auth/callback

# Security
JWT_SECRET=your_jwt_secret

# SMTP (Mailtrap or SMTP Provider)
SMTP_FROM=no-reply@example.com
SMTP_HOST=your_smtp_host
SMTP_PASS=your_smtp_password
SMTP_PORT=2525
SMTP_PROVIDER=mailtrap
SMTP_SECURE=false
SMTP_USER=your_smtp_user

###############################################################################
#                              GOOGLE TRENDS SERVICE                           #
###############################################################################

# MongoDB
MONGODB_DB_NAME=google_trends
MONGODB_URI=your_google_trends_mongo_uri
MONGO_URI=your_google_trends_mongo_uri

# NLP Settings
NLP_INFERENCE_ENDPOINT=/inference
NLP_REQUEST_TIMEOUT=10

###############################################################################
#                              NLP SERVICE                                     #
###############################################################################

NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key

###############################################################################
#                              YOUTUBE SERVICE                                 #
###############################################################################

YOUTUBE_API_KEY=your_youtube_api_key

###############################################################################
#                              POSTGRES                                        #
###############################################################################

POSTGRES_DB=users_db
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_USER=postgres